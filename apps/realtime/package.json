{
  "name": "realtime",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:temp": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node -r tsconfig-paths/register dist/index.js",
    "lint": "eslint src --ext .ts",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@chitchat/db": "workspace:*",
    "@chitchat/types": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "socket.io": "^4.8.1",
    "tsconfig-paths": "^4.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.19.19",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "5.9.2"
  }
}
